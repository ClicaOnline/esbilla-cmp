---
// esbilla-public/src/components/Panoya.astro
interface Props {
  variant?: 'realista' | 'minimalista' | 'geometrica';
  size?: string | number;
  class?: string;
  primary?: string;
  secondary?: string;
  accent?: string;
}

const { 
  variant = "realista", 
  size = "128", 
  class: className,
  primary = "#FFBF00",
  secondary = "#C2A561",
  accent = "#2F6E8D"
} = Astro.props;

// Estilos dinámicos para inyectar los colores del Dashboard
const styles = {
  "--esbilla-primary": primary,
  "--esbilla-secondary": secondary,
  "--esbilla-accent": accent,
};
---

<div class={`panoya-container ${className}`} style={styles}>
  {variant === 'realista' && (
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 540 100">
  <g font-family="'Nunito Variable', 'Nunito', sans-serif" font-weight="900" letter-spacing="-4">
    <text x="10" y="75" fill="#3D2B1F" font-size="80" style="font-family: 'Nunito Variable', 'Nunito', sans-serif; text-transform: uppercase;">ESBILLA</text>

    <text x="335" y="75" fill="#FFBF00" font-size="80" style="font-family: 'Nunito Variable', 'Nunito', sans-serif; text-transform: uppercase;">CMP</text>
  </g>
</svg>
  )}

  {variant === 'minimalista' && (
    <svg viewBox="0 0 128 128" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M64 120c-30 0-50-40-50-80S34 10 64 10s50 30 50 30-20 80-50 80z" fill="var(--esbilla-accent)"/>
      <ellipse cx="64" cy="60" rx="25" ry="45" fill="var(--esbilla-primary)"/>
    </svg>
  )}

  {variant === 'geometrica' && (
    <svg viewBox="0 0 128 128" width={size} height={size} fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M64 15 L84 45 L64 75 L44 45 Z" fill="var(--esbilla-primary)"/>
      <path d="M64 45 L84 75 L64 105 L44 75 Z" fill="var(--esbilla-primary)" opacity="0.7"/>
      <path d="M64 105 L72 120 L56 120 Z" fill="var(--esbilla-secondary)"/>
    </svg>
  )}
</div>

<style>
  .panoya-container {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  svg {
    height: auto;
    max-width: 100%;
  }
</style>